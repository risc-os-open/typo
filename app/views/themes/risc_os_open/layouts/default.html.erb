<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <%= csrf_meta_tag %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
    <%= page_header %>

    <title>RISC OS Open: News: <%=h page_title %></title>

    <%= stylesheet_link_tag 'theme/risc_os_open', media: 'all' %>
    <%= stylesheet_link_tag 'user-styles',        media: 'all' %>
  </head>
  <body>
    <%= render 'shared/fixed_header' %>

    <div id="template_main">

      <!-- Main body content -->

      <div id="template_body">
        <div id="template_body_content">
          <%= apphelp_flash() %>
          <h1><%= this_blog.blog_name %></h1>

          <br />
          <%= yield %>
          <%= javascript_tag 'show_dates_as_local_time();' %>
        </div>
      </div>

      <!-- Sidebar -->

      <div id="template_sidebar">
        <div id="template_sidebar_content">
          <div class="template_sidebar_node" id="search">
            <%= render :partial => "shared/search" %>
          </div>

          <%= render 'shared/fixed_sidebar' %>

          <% if hubssolib_privileged? %>
            <div class="template_sidebar_node">
              <h3>Administration</h3>

              <ul>
                <li><%= current_user_notice() %></li>

                <% if session[:user].present? %>
                  <li><%= link_to 'Publish', new_admin_content_path() %>
                  <li><%= link_to 'Manage articles', admin_content_index_path() %>
                <% end %>
              </ul>
            </div>
          <% end -%>

          <%= render_sidebars %>
        </div>
      </div>

      <div id="template_main_block_end"></div>
    </div>

    <%= render 'shared/fixed_footer' %>
  </body>
</html>
