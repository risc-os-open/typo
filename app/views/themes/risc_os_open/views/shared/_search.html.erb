<h3>Search</h3>

<%= form_with(url: articles_search_path(), method: :get, class: 'search_form') do |f| %>
  <%= f.search_field :q, value: params[:q], size: 14, placeholder: 'Search news' %>
  <%= f.submit('Go') %>
  <%= image_tag "spinner.gif", id: 'search_spinner', style: 'display: none' %>
<% end %>

<div id="search_results"></div>

<%=
  observe_field(
    'q',
    frequency: 1,
    url:       { controller: 'live', action: "search" },
    loading:   'Element.show("search_spinner")',
    complete:  'Element.hide("search_spinner")',
    update:    'search_results',
    with:      '"q=" + escape($F("q"))'
  )
%>
