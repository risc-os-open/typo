<h3><%=h title %></h3>

<ul>
  <% for comment in sidebar.comments.includes(:article) %>
    <li>
      <% title = show_username ? h(comment.author) : '' %>
      <% title << ' on ' + h(comment.article.title) if show_article %>
      <%= link_to_permalink comment, h(title) %>
    </li>
  <% end %>
</ul>
